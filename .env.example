# Dominion Ranger Environment Configuration
# Copy to .env and fill in values

# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://ranger:ranger@localhost:5432/dominion_ranger
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ─── Redis (BullMQ) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ─────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── API Keys (Providers) ──────────────────────────
REGRID_API_KEY=
PROPERTY_RADAR_API_KEY=
FORECLOSURE_RADAR_API_KEY=
REISKIP_API_KEY=

# ─── RBAC ───────────────────────────────────────────
# JWT secret for API auth (generate a strong random string)
JWT_SECRET=
# Admin bootstrap token (used once for initial admin creation)
ADMIN_BOOTSTRAP_TOKEN=

# ─── Sentinel (optional — webhook fires only if set) ─
# SENTINEL_WEBHOOK_URL=https://sentinel.dominionhomedeals.com/api/leads/inbound
