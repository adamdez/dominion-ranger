{
  "name": "dominion-ranger",
  "version": "1.0.0",
  "description": "Dominion Ranger — Dual-Layer Distress Detection & Lead Intelligence Engine",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seeds/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "jobs:worker": "tsx src/jobs/worker.ts",
    "backfill:score": "tsx src/scripts/backfill-scoring.ts",
    "backfill:rescore": "tsx src/scripts/backfill-scoring.ts --rescore",
    "db:migrate:seed": "tsx src/scripts/run-migration.ts 0008_seed_scoring_config.sql",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "db:migrate:auth": "tsx src/scripts/run-migration.ts 0010_users_auth.sql",
    "system:status": "tsx src/scripts/recover-system.ts --status",
    "system:seed-config": "tsx src/scripts/recover-system.ts --seed-config",
    "system:score": "tsx src/scripts/recover-system.ts --score",
    "system:import": "tsx src/scripts/recover-system.ts --import",
    "system:recover": "tsx src/scripts/recover-system.ts --full"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.21.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^5.12.2",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
